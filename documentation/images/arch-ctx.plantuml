@startuml
!include plantuml-style.puml
title System Context: Wainlux K6 Laser Service
!$port8081="\n<color #blue>8081"
!$port8082="\n<color #blue>8082"
!$port8083="\n<color #blue>8083"

rectangle "Pi Zero W" as pi {
  card "Docker Containers" as pi.docker {
    card "Laser Service\n(port 8081)" as service <<system>>
  }
}

rectangle "Development Workstation" as workstation {
  card "Browser" as browser
  card "CLI App" as cli <<system>>
  card "VS Code + LLM" as vscode
}

actor "Operator" as user
node "K6 Laser" as laser

rectangle "External Services" as external {
    card "Docker Containers" as external.docker {
        card "MCP Hub" as mcp <<system>>
        card "Audio Analyzer" as audio <<system>>
      }
    card "external app\n(eg neoCV)" as external.application
}

user --> browser : "1. Review UI"
user --> cli : "2. Submit Jobs"
user --> vscode : "3. LLM Integration"
user .-> external.application

browser --> service <<system>> : HTTP $port8081
cli --> service <<system>> : HTTP API $port8081
vscode --> mcp <<system>> : MCP Protocol $port8083
mcp --> service <<system>> : HTTP API $port8081
external.application --> service <<system>> : HTTP API $port8081

service --> laser <<system>> : USB Serial
audio <-- service <<system>> : HTTP API $port8082

legend
    Ports are noted overlap free here to allow co-location
    This is not mandatory
end legend
@enduml
