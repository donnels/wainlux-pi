;; Rust K6 raster DATA packet (0x22).
;; The 16-bit big-endian size includes opcode, size, payload and checksum.

(defattrs :bg-header {:fill "#e8f4f8"})
(defattrs :bg-data {:fill "#fff4e8"})

(draw-column-headers)
(draw-box "0x22 (Raster DATA)" [:box-first {:span 8} :bg-header])
(draw-box "Length MSB (u16 BE)" [:box-related {:span 8} :bg-header])
(draw-box "Length LSB" [:box-related {:span 8} :bg-header])
(draw-box "First payload byte" [:box-last {:span 8} :bg-data])

(next-row)
(draw-gap "... packed 1-bit raster payload (up to 1900 bytes) ..." [{:span 24} :bg-data])
(draw-box "Checksum" [:box-last {:span 8} :bg-header])
