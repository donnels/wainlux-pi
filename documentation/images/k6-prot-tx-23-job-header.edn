;; Rust K6 raster JOB_HEADER (0x23), 38 bytes.
;; Multi-byte numeric fields are big-endian. Raster-only fields are populated;
;; bytes reserved for vector data are zero in the current driver.

(defattrs :bg-fixed {:fill "#e8f4f8"})
(defattrs :bg-raster {:fill "#ffe8e8"})
(defattrs :bg-position {:fill "#f8f8e8"})
(defattrs :bg-reserved {:fill "#eeeeee"})

(draw-column-headers)
(draw-box "0x23" [:box-first {:span 8} :bg-fixed])
(draw-box "0x00" [:box-related {:span 8} :bg-fixed])
(draw-box "0x26 (38 bytes)" [:box-related {:span 8} :bg-fixed])
(draw-box "Packet count MSB" [:box-last {:span 8} :bg-fixed])

(next-row)
(draw-box "Packet count LSB" [:box-first {:span 8} :bg-fixed])
(draw-box "0x01 mode" [:box-related {:span 8} :bg-fixed])
(draw-box "Raster width MSB" [:box-related {:span 8} :bg-raster])
(draw-box "Raster width LSB" [:box-last {:span 8} :bg-raster])

(next-row)
(draw-box "Raster height MSB" [:box-first {:span 8} :bg-raster])
(draw-box "Raster height LSB" [:box-related {:span 8} :bg-raster])
(draw-box "0x00 offset MSB" [:box-related {:span 8} :bg-fixed])
(draw-box "0x21 offset LSB (=33)" [:box-last {:span 8} :bg-fixed])

(next-row)
(draw-box "Power MSB" [:box-first {:span 8} :bg-raster])
(draw-box "Power LSB" [:box-related {:span 8} :bg-raster])
(draw-box "Depth MSB" [:box-related {:span 8} :bg-raster])
(draw-box "Depth LSB" [:box-last {:span 8} :bg-raster])

(next-row)
(draw-box "Vector width: 0x0000" [:box-first {:span 8} :bg-reserved])
(draw-box "Vector height: 0x0000" [:box-related {:span 8} :bg-reserved])
(draw-box "Total size (u32 BE)" [:box-related {:span 16} :bg-raster])

(next-row)
(draw-box "Vector power: 0x0000" [:box-first {:span 8} :bg-reserved])
(draw-box "Vector depth: 0x0000" [:box-related {:span 8} :bg-reserved])
(draw-box "Vector count: 0x00000000" [:box-related {:span 16} :bg-reserved])

(next-row)
(draw-box "Center X MSB" [:box-first {:span 8} :bg-position])
(draw-box "Center X LSB" [:box-related {:span 8} :bg-position])
(draw-box "Center Y MSB" [:box-related {:span 8} :bg-position])
(draw-box "Center Y LSB" [:box-last {:span 8} :bg-position])

(next-row)
(draw-box "0x01 repeat" [:box-first {:span 8} :bg-fixed])
(draw-box "0x00 reserved" [:box-related {:span 8} :bg-fixed])
